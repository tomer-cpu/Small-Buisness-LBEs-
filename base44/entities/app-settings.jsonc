{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "enum": ["ILS", "USD", "EUR", "GBP"],
      "default": "ILS",
      "description": "מטבע ברירת מחדל"
    },
    "language": {
      "type": "string",
      "enum": ["he", "en"],
      "default": "he",
      "description": "שפת תצוגה"
    },
    "business_name": {
      "type": "string",
      "description": "שם העסק"
    }
  },
  "required": ["currency"]
}
